{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/ios/**",
              "ui_kits/yearstrong/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Gluten|Nunito|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Gluten, Nunito, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|danger|key|ref|className|style|children)$/]",
        "message": "<SheetAction> doesn't accept that prop. Declared props: value, label, danger."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|danger|key|ref|className|style|children)$/]",
        "message": "<AlertAction> doesn't accept that prop. Declared props: value, label, danger."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aside'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Aside> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet|ref|plain)$/]",
        "message": "<Button> variant must be one of 'primary' | 'quiet' | 'ref' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|flat|sunken)$/]",
        "message": "<Card> tone must be one of 'card' | 'flat' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChecklistItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|done|key|ref|className|style|children)$/]",
        "message": "<ChecklistItem> doesn't accept that prop. Declared props: label, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|value|done|onChange|key|ref|className|style|children)$/]",
        "message": "<DayStrip> doesn't accept that prop. Declared props: days, value, done, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ChipItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='LargeTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<LargeTitle> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|chevron|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: label, value, chevron, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MacroItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|accent|key|ref|className|style|children)$/]",
        "message": "<MacroItem> doesn't accept that prop. Declared props: label, value, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|text|key|ref|className|style|children)$/]",
        "message": "<MealOption> doesn't accept that prop. Declared props: key, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|danger|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: value, label, danger."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:back|onBack|title|action|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: back, onBack, title, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressSegments'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|done|tone|key|ref|className|style|children)$/]",
        "message": "<ProgressSegments> doesn't accept that prop. Declared props: total, done, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressSegments'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:action|ref)$/]",
        "message": "<ProgressSegments> tone must be one of 'action' | 'ref'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RefCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|cite|children|key|ref|className|style|children)$/]",
        "message": "<RefCard> doesn't accept that prop. Declared props: title, cite, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentItem> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|reps|done|key|ref|className|style|children)$/]",
        "message": "<SetEntry> doesn't accept that prop. Declared props: label, reps, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|className|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, onClose, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|done|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, sub, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|unit|onChange|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, min, max, step, unit, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|onChange|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, label, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:action|ref)$/]",
        "message": "<TabItem> tone must be one of 'action' | 'ref'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|done)$/]",
        "message": "<Toast> tone must be one of 'default' | 'done'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
